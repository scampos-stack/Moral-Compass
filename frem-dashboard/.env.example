# Moral Compass / Frém dashboard
# Copy to .env.local and fill in. Never commit real values.

# ── Supabase ─────────────────────────────────────────────────────────────
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_JWKS_URL=

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# ── Faire (revenue) ──────────────────────────────────────────────────────
FAIRE_ACCESS_TOKEN=
FAIRE_API_BASE=https://www.faire.com/external-api/v2

# ── Woodpecker (outreach effort) ─────────────────────────────────────────
WOODPECKER_API_KEY=
WOODPECKER_API_BASE=https://api.woodpecker.co/rest/v1

# ── Sync jobs ────────────────────────────────────────────────────────────
# Guards POST /api/sync/faire. Generate with: openssl rand -hex 32
CRON_SECRET=

# ── Attribution ──────────────────────────────────────────────────────────
ATTRIBUTION_WINDOW_HOURS=72

# ── GoHighLevel (CRM) ────────────────────────────────────────────────────
GHL_PRIVATE_INTEGRATION_TOKEN=
GHL_API_BASE=https://services.leadconnectorhq.com
GHL_LOCATION_ID=

